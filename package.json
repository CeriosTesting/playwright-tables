{
	"name": "@cerios/playwright-table",
	"version": "2.1.0",
	"description": "Type-safe, auto-waiting Playwright locators and retrying expect matchers for HTML tables and data grids: find rows and cells by header name, assert whole tables, and handle colspan, rowspan, pagination, virtual scrolling and grids such as AG Grid, MUI X Data Grid and Angular Material.",
	"keywords": [
		"ag-grid",
		"assertions",
		"data-grid",
		"e2e",
		"expect",
		"html",
		"locator",
		"pagination",
		"playwright",
		"table",
		"testing",
		"virtual-scroll"
	],
	"homepage": "https://github.com/CeriosTesting/playwright-tables#readme",
	"bugs": {
		"url": "https://github.com/CeriosTesting/playwright-tables/issues"
	},
	"license": "MIT",
	"author": "Ronald Veth - Cerios",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CeriosTesting/playwright-tables.git"
	},
	"files": [
		"dist"
	],
	"type": "commonjs",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": "./dist/index.mjs",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"test": "playwright test",
		"prepare": "husky",
		"build": "tsdown",
		"serve": "serve tests/demo-html -p 3000",
		"check-exports": "attw --pack .",
		"changeset": "npx changeset",
		"changeset:version": "changeset version && npm i && npm run format",
		"changeset:publish": "changeset publish",
		"compile": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
		"update-all-packages": "npx npm-check-updates -u && npm i",
		"lint": "oxlint --type-aware --type-check",
		"lint:fix": "oxlint --type-aware --type-check --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@changesets/cli": "^3.0.3",
		"@playwright/test": "^1.64.1",
		"@types/node": "^24.19.2",
		"ag-grid-community": "^36.2.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"serve": "^14.2.6",
		"tsdown": "^0.23.2",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"@playwright/test": "^1.45.0"
	},
	"overrides": {
		"compression": "^1.8.2"
	}
}
